# Backend environment. Copy to apps/api/.env — real values stay uncommitted.
# Full documentation of each variable: see root .env.example

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_MEDIA_BUCKET=shareable-assets

OWNER_USER_ID=REPLACE_ME

N8N_BASE_URL=http://localhost:5678
N8N_GENERATION_WEBHOOK_URL=REPLACE_ME
N8N_DISTRIBUTION_WEBHOOK_URL=REPLACE_ME
N8N_WEBHOOK_SECRET=REPLACE_ME
N8N_CALLBACK_BASE_URL=http://host.docker.internal:3000
N8N_CALLBACK_SECRET=REPLACE_ME
N8N_ENCRYPTION_KEY=REPLACE_WITH_PERSISTENT_SECRET

GEMMA_API_KEY=REPLACE_ME
GEMMA_MODEL=gemma-4-26b-a4b-it

BUFFER_API_KEY=REPLACE_ME
BUFFER_ORGANIZATION_ID=REPLACE_ME
BUFFER_INSTAGRAM_CHANNEL_ID=REPLACE_ME
BUFFER_FACEBOOK_CHANNEL_ID=REPLACE_ME
BUFFER_X_CHANNEL_ID=REPLACE_ME

DEFAULT_TIMEZONE=Asia/Karachi
