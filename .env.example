# FlowToFeed environment template.
# Copy to apps/api/.env for the backend. Never commit real values.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Supabase (project URL + keys from supabase.com dashboard)
# Publishable key replaces anon, Secret key replaces service_role
# (legacy keys deprecated end of 2026).
SUPABASE_URL=REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_MEDIA_BUCKET=shareable-assets
# Postgres connection string (dashboard -> Connect -> Session pooler).
# Dev/migrations only — not used by the running app.
SUPABASE_DB_URL=REPLACE_ME

# Single owner account id (copied from Supabase auth.users after first signup)
OWNER_USER_ID=REPLACE_ME

# n8n (local Docker by default)
N8N_BASE_URL=http://localhost:5678
N8N_GENERATION_WEBHOOK_URL=REPLACE_ME
N8N_DISTRIBUTION_WEBHOOK_URL=REPLACE_ME
N8N_WEBHOOK_SECRET=REPLACE_ME
N8N_CALLBACK_BASE_URL=http://host.docker.internal:3000
N8N_CALLBACK_SECRET=REPLACE_ME
N8N_ENCRYPTION_KEY=REPLACE_WITH_PERSISTENT_SECRET

# Gemma via Google AI Studio / Gemini API (hosted Gemma)
GEMMA_API_KEY=REPLACE_ME
GEMMA_MODEL=gemma-4-26b-a4b-it

# Buffer (GraphQL API bearer token + channel ids)
BUFFER_API_KEY=REPLACE_ME
BUFFER_ORGANIZATION_ID=REPLACE_ME
BUFFER_INSTAGRAM_CHANNEL_ID=REPLACE_ME
BUFFER_FACEBOOK_CHANNEL_ID=REPLACE_ME
BUFFER_X_CHANNEL_ID=REPLACE_ME

DEFAULT_TIMEZONE=Asia/Karachi
